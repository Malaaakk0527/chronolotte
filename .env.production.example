# ============================================================
# CHRONOLETTE - Déploiement en production (Render + Supabase)
# Copier ce contenu dans les variables d'environnement de Render
# (Render Dashboard -> Service -> Environment -> Add New Variable)
# ============================================================

APP_NAME=Chronolette
APP_ENV=production
APP_DEBUG=false
APP_URL=https://chronolette.onrender.com   # ⚠️ à remplacer par l'URL réelle de Render

# --- Base de données Supabase (PostgreSQL) ---
DB_CONNECTION=pgsql
# Exemple: db.xxxx.supabase.co (la partie "host" de ta connection string)
DB_HOST=db.xxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=TON_MOT_DE_PASSE_SUPABASE
DB_SSLMODE=require

# --- Stockage images Supabase (S3) ---
# Créer les clés : Supabase Dashboard -> Storage -> S3 Access Keys -> Create
FILESYSTEM_DISK=supabase
SUPABASE_S3_KEY=TON_ACCESS_KEY
SUPABASE_S3_SECRET=TON_SECRET_KEY
SUPABASE_S3_ENDPOINT=https://TON_PROJET.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=chronolette
SUPABASE_STORAGE_URL=https://TON_PROJET.supabase.co/storage/v1/object/public/chronolette

# --- Sessions / Cache / Queue (tables en base) ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Divers ---
APP_KEY=base64:... # généré automatiquement par Render (generateValue)
MIGRATE_ON_START=true
